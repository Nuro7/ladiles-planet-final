# Local Express server
PORT=5050
NODE_ENV=development
HOST=127.0.0.1
# Never enable this on a hosted server. Authentication is otherwise mandatory.
ALLOW_LOCAL_DEV_AUTH=false
FRONTEND_URL=http://localhost:3002
# Exact reverse-proxy IP/subnet only; do not use a blanket trust-proxy setting.
TRUSTED_PROXY_CIDRS=
HIGGSFIELD_OWNER_USER_ID=
# Generate a random secret of 32+ characters; required in production.
MEDIA_SESSION_SECRET=
HIGGSFIELD_OAUTH_REDIRECT_URI=http://localhost:5050/api/higgsfield-oauth/callback
HIGGSFIELD_SPEND_ENABLED=false
# Create with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Save separately in a password manager and secret store.
# Keep the SAME key across restarts, deployments and backup restores.
HIGGSFIELD_TOKEN_ENCRYPTION_KEY=
MEDIA_CONCURRENCY=1
GENERATION_CONCURRENCY=2
FFMPEG_THREADS=1
MIN_FREE_DISK_MB=512
SHUTDOWN_TIMEOUT_MS=300000

# Supabase and PostgreSQL
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=
DATABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Optional overrides. In production mount ALL backend/data on a persistent disk.
# STUDIO_TEMPLATE_STORE=/app/backend/data/studio-templates.json
# STUDIO_EXPERIENCE_STORE=/app/backend/data/studio-experiences.json
# SAVED_BRIDE_ROOT=/app/backend/data/saved-brides
# DRESS_FLOW_STORE=/app/backend/data/dress-flow-sync.json
FLAGSHIP_VIDEO_VARIANT=lite

# Optional AI providers. Add only the providers you intend to use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FAL_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
KLING_API_KEY=
KLING_SECRET_KEY=
VIDEO_PROVIDER=

# New studio integrations (credentials stay server-side)
# HF_CREDENTIALS can replace the two HIGGSFIELD_API_* variables above.
HF_CREDENTIALS=
FLOW_MCP_URL=http://127.0.0.1:8787
FLOW_MCP_MODEL=Omni 1.1 Flash
FLOW_MCP_MAX_CREDITS=40
# Optional: set the same FLOW_MCP_HOME in both backend and Flow worker.
# FLOW_MCP_HOME=/var/lib/ladies-planet/flow
# Defaults to backend/data/flow-mcp: isolated owner browser and worker token.
FLOW_MCP_AUTOSTART=false
FLOW_MCP_CDP_PORT=9333
# Optional saved Flow project URL; otherwise the worker creates/restores it.
# FLOW_MCP_PROJECT_URL=
# Linux requires installed Google Chrome plus an owner desktop/Xvfb display.
# DISPLAY=:99
# Optional media paths (bundled FFmpeg is used when FFMPEG_PATH is unset).
# FFMPEG_PATH=
# FLOW_MCP_OUTPUT=
